# Copy to .env and adjust. Never commit .env (it is git-ignored).
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (docker compose up -d starts one on port 5433)
DATABASE_URL=postgresql+psycopg://fig:fig@localhost:5433/financial_impact_graph
# Used by the pytest suite (separate database so tests never touch dev data)
TEST_DATABASE_URL=postgresql+psycopg://fig:fig@localhost:5433/financial_impact_graph_test

# --- LLM -------------------------------------------------------------------
# mock      = deterministic, offline, outputs labelled SIMULATED (default, no cost)
# gemini    = Google Gemini (free tier key from Google AI Studio)       -> GEMINI_API_KEY
# groq      = Groq, open models such as Llama (free tier, no card)      -> GROQ_API_KEY
# xai       = xAI Grok                                                 -> XAI_API_KEY + XAI_MODEL
# ollama    = local Ollama server, no key (install Ollama, `ollama pull llama3.1`)
# anthropic = Claude via the official SDK (billed API usage; a Claude subscription has no API credits)
# fallback  = try LLM_FALLBACK_CHAIN in order; members without a key are skipped; mock is never used
LLM_PROVIDER=mock
LLM_FALLBACK_CHAIN=gemini,groq
LLM_FALLBACK_COOLDOWN_SECONDS=60
# If every provider is rate-limited, wait up to this many seconds in total for one to recover (0 = fail at once)
LLM_FALLBACK_MAX_WAIT_SECONDS=90

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Gemini 2.5 "thinking" uses part of the output budget; low keeps long explanations from truncating
GEMINI_REASONING_EFFORT=low
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
XAI_API_KEY=
XAI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
OPENAI_COMPAT_MAX_TOKENS=8192

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_USE_SERVER_FALLBACKS=true

# --- News ------------------------------------------------------------------
# gdelt   = GDELT DOC 2.0 API, no key, headlines + metadata only
# finnhub = Finnhub /news, requires FINNHUB_API_KEY, headline + summary
# fixture = SIMULATED demo articles from data/fixtures/articles.json
NEWS_PROVIDER=gdelt
FINNHUB_API_KEY=
NEWS_MAX_ARTICLES=25

# --- Market data -----------------------------------------------------------
# none         = historical analysis reports UNAVAILABLE (default)
# yahoo_chart  = unofficial Yahoo chart endpoint, no key; research/demo use only (check licensing)
# alphavantage = Alpha Vantage, requires MARKET_DATA_API_KEY (free tier: ~100 recent sessions)
MARKET_DATA_PROVIDER=none
MARKET_DATA_API_KEY=

# --- HTTP ------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3

# --- Scoring weights (heuristic, not calibrated) ----------------------------
SCORE_WEIGHT_CONFIDENCE=0.30
SCORE_WEIGHT_EVIDENCE=0.30
SCORE_WEIGHT_RELEVANCE=0.25
SCORE_WEIGHT_HISTORICAL=0.15

# --- Analysis bounds -------------------------------------------------------
GRAPH_KB_EXPANSION_DEPTH=5
GRAPH_MAX_NODES=150
PATH_MAX_DEPTH=7
PATH_MAX_TOTAL=60
PATH_MAX_PER_ASSET=5
PATH_LENGTH_DECAY=0.9
MARKET_MAX_ASSETS=8
MARKET_EVENT_WINDOWS=1,3,5,20
HISTORICAL_MIN_COMPARISONS=2

# --- Black Swan simulator (defaults point at data/; override only to use other files) ----------
# SIMULATION_SCENARIOS_FILE=data/simulation/scenarios.json
# SIMULATION_LAYERS_FILE=data/simulation/visual_layers.json
# SIMULATION_MODEL_DIR=data/models
SIMULATION_SCENARIO_MODEL_ID=scenario_conditional_v1

# --- Browser access (CORS) ------------------------------------------------------------------
# Origins allowed to call the API from a browser (comma-separated). Default: the Vite dev server.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PATTERN_LIBRARY_FILE=data/patterns/pattern_library_v1.json

# --- Publisher RSS feeds (NEWS_PROVIDER=rss or provider "rss" in POST /api/articles/ingest) -----------
# No API key. Format: key|Display name|https://feed-url, comma-separated. Defaults (in app/core/config.py):
# Hindustan Times (India, Business), Economic Times Markets, Mint Markets, BBC (Business, World), Bloomberg Markets.
# RSS_FEEDS=hindustan_times_india|Hindustan Times - India|https://www.hindustantimes.com/feeds/rss/india-news/rssfeed.xml,bbc_business|BBC News - Business|https://feeds.bbci.co.uk/news/business/rss.xml
